      "nom": "Bon jardinier",
      "texte": "Faire 500 points en chrono"
    },
    {
      "id": "s1000",
      "nom": "Terreur des taupes",
      "texte": "Faire 1 000 points en chrono"
    },
    {
      "id": "survie",
      "nom": "Increvable",
      "texte": "Faire 500 points en survie"
    },
    {
      "id": "mille",
      "nom": "Mille taupes",
      "texte": "Taper 1 000 taupes en tout"
    },
    {
      "id": "dorees",
